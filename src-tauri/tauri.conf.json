{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotesPro",
  "version": "1.0.3",
  "identifier": "com.notespro.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NotesPro",
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "tabbed"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
